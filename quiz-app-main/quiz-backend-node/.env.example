# AssessSphere — Node.js/Express/MongoDB Backend (MERN Stack)

# ── Server ──────────────────────────────────────────────────────
PORT=8080

# ── MongoDB ─────────────────────────────────────────────────────
# Local:
MONGO_URI=mongodb://localhost:27017/assesssphere
# Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/assesssphere?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ── Email (Gmail SMTP) ───────────────────────────────────────────
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=your_gmail_app_password

# ── Judge0 Code Execution (optional) ────────────────────────────
JUDGE0_ENABLED=false
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
